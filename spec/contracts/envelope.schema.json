{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "furmtech.sim/1"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "command",
        "ack",
        "event",
        "error"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocol",
    "session",
    "instanceId",
    "requestId",
    "modelVersion",
    "revision",
    "kind",
    "name",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "id": "S23",
  "version": "0.1.0",
  "metadata": {
    "title": "McCabe–Thiele design and reflux",
    "subject": "Separations",
    "objectives": [
      "Compare reflux vs stages at same purity and feed. No energy/cost ranking until latent heat/feed rate/utility prices supplied. Stage efficiency and flooding require additional models/data."
    ],

{
  "id": "S25",
  "version": "0.1.0",
  "metadata": {
    "title": "PID control, saturation and recovery",
    "subject": "Control",
    "objectives": [
      "Tune for settling time, overshoot and time saturated on fixed scenarios, compare achievable and unreachable demands; multiple tunings meet requirements. EXP04 uses measured flow and actual controller settings."
    ],
    "fidelity": [
      "F4"
    ]
  },
  "variant": "starter",
  "model": "model.S25.starter",
  "inputs": [
    {
      "id": "Kc",
      "label": "Controller gain K𝒸",
      "unit": "1",
      "min": 0.0,
      "max": 10.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "Ti",
      "label": "Integral time Tᵢ",
      "unit": "s",
      "min": 0.5,
      "max": 50.0,
      "default": 5.0,
      "step": 0.1,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "Td",
      "label": "Derivative time T𝒹",
      "unit": "s",
      "min": 0.0,
      "max": 5.0,
      "default": 0.0,
      "step": 0.1,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "r",
      "label": "Setpoint r",
      "unit": "1",
      "min": 0.0,
      "max": 1.5,
      "default": 0.5,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "d",
      "label": "Load disturbance d",
      "unit": "1",
      "min": -0.5,
      "max": 0.5,
      "default": 0.0,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "pv",
      "unit": "1"
    },
    {
      "id": "setpoint",
      "unit": "1"
    },
    {
      "id": "raw_output",
      "unit": "1"
    },
    {
      "id": "applied_output",
      "unit": "1"
    },
    {
      "id": "integral_state",
      "unit": "1"
    },
    {
      "id": "saturation_time",
      "unit": "s"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S25",
    "anchors": [
      "actuator_clamp",
      "integral_state",
      "measured_pv"
    ]

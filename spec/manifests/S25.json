  "initialState": {
    "y": 0,
    "yprev": 0,
    "I": 0,
    "Df": 0,
    "u": 0
  },
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S25.investigate",
    "activity.S25.challenge"
  ],
  "applicabilityRules": [
    "S25.assumptions.section-I"
  ],
  "references": [

{
  "id": "S24",
  "version": "0.1.0",
  "metadata": {
    "title": "Cake filtration performance and filter area",
    "subject": "Separations",
    "objectives": [
      "For a target volume by a deadline find minimum continuous area, round to candidate elements and forward check. Zero time and positive V is infeasible. Compare clean medium-only limit."
    ],
    "fidelity": [
      "F2",
      "F6"
    ]
  },
  "variant": "starter",
  "model": "model.S24.starter",
  "inputs": [

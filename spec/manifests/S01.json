{
  "id": "S01",
  "version": "0.1.0",
  "metadata": {
    "title": "Rate, gradient and accumulated volume",
    "subject": "Mathematics",
    "objectives": [
      "Determine b for a target volume given m and endpoints; zero duration makes the inverse unidentifiable. Challenge: equal final flows can have different inventories."
    ],
    "fidelity": [
      "F1"
    ]
  },
  "variant": "starter",
  "model": "model.S01.starter",
  "inputs": [
    {
      "id": "b",
      "label": "Initial flow b",
      "unit": "m³/s",
      "min": 0.0,
      "max": 0.01,
      "default": 0.002,
      "step": 0.0001,
      "alternative": "L/min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "m",
      "label": "Ramp slope m",
      "unit": "m³/s²",
      "min": -0.0001,
      "max": 0.0001,
      "default": 2e-05,
      "step": 1e-06,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "t",
      "label": "End time t",
      "unit": "s",
      "min": 0.0,
      "max": 100.0,
      "default": 50.0,
      "step": 1.0,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "a",
      "label": "Start time a",
      "unit": "s",
      "min": 0.0,
      "max": 100.0,
      "default": 0.0,
      "step": 1.0,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "q",
      "unit": "m³/s"
    },
    {
      "id": "slope",
      "unit": "m³/s²"
    },
    {
      "id": "volume",
      "unit": "m³"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S01",
    "anchors": [
      "flow_area",
      "tangent",
      "end_cursor"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S01.investigate",
    "activity.S01.challenge"
  ],
  "applicabilityRules": [
    "S01.assumptions.section-I"
  ],
  "references": [
    "FNC"
  ],
  "verification": [
    "S01.fixtures.section-M"
  ]
}

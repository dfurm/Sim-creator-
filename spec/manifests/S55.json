{
  "id": "S55",
  "version": "0.1.0",
  "metadata": {
    "title": "Humidification and drying",
    "subject": "Mass transfer",
    "objectives": [
      "Determine residence time for an outlet moisture specification, then vary air humidity in a separate scenario."
    ],
    "fidelity": [
      "F2"
    ]
  },
  "variant": "starter",
  "model": "model.S55.starter",
  "inputs": [
    {
      "id": "rh",
      "label": "Relative humidity RH",

  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S20",
    "anchors": [
      "levenspiel_area",
      "cstr_rectangle",
      "pfr_integral"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S20.investigate",
    "activity.S20.challenge"
  ],
  "applicabilityRules": [

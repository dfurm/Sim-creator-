{
  "id": "S05",
  "version": "0.1.0",
  "metadata": {
    "title": "Laminar pipe velocity and shear",
    "subject": "Fluids",
    "objectives": [
      "Find Q for a wall shear limit; determine whether the answer is laminar. Transfer to a viscous liquid at fixed Q and explain which field changes."
    ],
    "fidelity": [
      "F1"
    ]
  },
  "variant": "starter",
  "model": "model.S05.starter",
  "inputs": [
    {
      "id": "Q",
      "label": "Volume flow Q",
      "unit": "m³/s",
      "min": 0.0,
      "max": 0.0001,
      "default": 1e-05,
      "step": 1e-06,
      "alternative": "L/min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "R",
      "label": "Tube radius R",
      "unit": "m",
      "min": 0.003,
      "max": 0.025,
      "default": 0.01,
      "step": 0.0001,
      "alternative": "mm",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "mu",
      "label": "Dynamic viscosity μ",
      "unit": "Pa·s",
      "min": 0.001,
      "max": 0.05,
      "default": 0.001,
      "step": 0.0001,
      "alternative": "mPa·s",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "s",
      "label": "Radial fraction r/R",
      "unit": "1",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "mean_velocity",
      "unit": "m/s"
    },
    {
      "id": "centre_velocity",
      "unit": "m/s"
    },
    {
      "id": "probe_velocity",
      "unit": "m/s"
    },
    {
      "id": "wall_shear",
      "unit": "Pa"
    },
    {
      "id": "pressure_gradient_magnitude",
      "unit": "Pa/m"
    },
    {
      "id": "Re",
      "unit": "1"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S05",
    "anchors": [
      "velocity_profile",
      "wall_shear",
      "annulus"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S05.investigate",
    "activity.S05.challenge"
  ],
  "applicabilityRules": [
    "S05.assumptions.section-I"
  ],
  "references": [
    "DOE",
    "FLOW"
  ],
  "verification": [
    "S05.fixtures.section-M"
  ]
}

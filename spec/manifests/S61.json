{
  "id": "S61",
  "version": "0.1.0",
  "metadata": {
    "title": "Liquid–liquid extraction stages",
    "subject": "Separations",
    "objectives": [
      "Select stage count for recovery at a fixed solvent budget."
    ],
    "fidelity": [
      "F2"
    ]
  },
  "variant": "starter",
  "model": "model.S61.starter",
  "inputs": [
    {
      "id": "K",
      "label": "Partition coefficient K",
      "unit": "1",

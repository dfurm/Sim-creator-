{
  "id": "S52",
  "version": "0.1.0",
  "metadata": {
    "title": "Radiation and natural convection",
    "subject": "Heat transfer",
    "objectives": [
      "Infer surface temperature for imposed heat load and compare uncertainty in h and ε."
    ],
    "fidelity": [
      "F2"
    ]
  },
  "variant": "starter",
  "model": "model.S52.starter",
  "inputs": [
    {
      "id": "Ts",
      "label": "Surface Tₛ",
      "unit": "K",
      "min": 280.0,
      "max": 500.0,
      "default": 330.0,
      "step": 1.0,
      "alternative": "°C",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "eps",
      "label": "Emissivity ε",
      "unit": "1",
      "min": 0.0,
      "max": 1.0,
      "default": 0.8,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "h",
      "label": "Effective convection h",
      "unit": "W/(m²·K)",
      "min": 0.0,
      "max": 30.0,
      "default": 5.0,
      "step": 0.5,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "radiative_flux",
      "unit": "W/m²"
    },
    {
      "id": "convective_flux",
      "unit": "W/m²"
    },
    {
      "id": "Rayleigh",
      "unit": "1"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S52",
    "anchors": [
      "equipment_view",
      "operating_point"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S52.investigate",
    "activity.S52.challenge"
  ],
  "applicabilityRules": [
    "S52.assumptions.section-I"
  ],
  "references": [
    "HEAT"
  ],
  "verification": [
    "S52.fixtures.section-M"
  ]
}

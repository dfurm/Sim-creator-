{
  "id": "S42",
  "version": "0.1.0",
  "metadata": {
    "title": "Flow metering, orifice and Venturi",
    "subject": "Fluids",
    "objectives": [
      "Fit Cd against gravimetric reference then test on different runs."
    ],
    "fidelity": [
      "F3"
    ]
  },
  "variant": "starter",
  "model": "model.S42.starter",
  "inputs": [
    {
      "id": "beta",
      "label": "Diameter ratio β",
      "unit": "1",
      "min": 0.2,
      "max": 0.8,
      "default": 0.5,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "dp",
      "label": "Measured differential Δp",
      "unit": "Pa",
      "min": 0.0,
      "max": 10000.0,
      "default": 1000.0,
      "step": 10.0,
      "alternative": "kPa",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "Cd",
      "label": "Assumed discharge coefficient Cd",
      "unit": "1",
      "min": 0.4,
      "max": 1.0,
      "default": 0.95,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "inferred_flow",
      "unit": "m³/s"
    },
    {
      "id": "throat_velocity",
      "unit": "m/s"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S42",
    "anchors": [
      "equipment_view",
      "operating_point"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S42.investigate",
    "activity.S42.challenge"
  ],
  "applicabilityRules": [
    "S42.assumptions.section-I"
  ],
  "references": [
    "DOE"
  ],
  "verification": [
    "S42.fixtures.section-M"
  ]
}

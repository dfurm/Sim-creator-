{
  "id": "S26",
  "version": "0.1.0",
  "metadata": {
    "title": "Numerical integration and timestep convergence",
    "subject": "Mathematics",
    "objectives": [
      "Choose largest step meeting prescribed endpoint error and positivity; compare evaluations per step across solvers. Use aligned refinements, avoid round-off dominated apparent order."
    ],
    "fidelity": [
      "F4"
    ]
  },
  "variant": "starter",
  "model": "model.S26.starter",
  "inputs": [
    {
      "id": "lam",
      "label": "Decay rate λ",
      "unit": "1/s",
      "min": 0.1,
      "max": 10.0,
      "default": 1.0,
      "step": 0.1,
      "alternative": "1/min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "dt",
      "label": "Time step Δt",
      "unit": "s",
      "min": 0.01,
      "max": 4.0,
      "default": 0.5,
      "step": 0.01,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "T",
      "label": "End time T",
      "unit": "s",
      "min": 1.0,
      "max": 20.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "exact",
      "unit": "1"
    },
    {
      "id": "numerical",
      "unit": "1"
    },
    {
      "id": "abs_error",
      "unit": "1"
    },
    {
      "id": "refinement_order",
      "unit": "1"
    },
    {
      "id": "steps",
      "unit": "count"
    },
    {
      "id": "amplification",
      "unit": "1"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S26",
    "anchors": [
      "time_step",
      "exact_trace",
      "stability_boundary"
    ]
  },
  "initialState": {
    "y": 1
  },
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S26.investigate",
    "activity.S26.challenge"
  ],
  "applicabilityRules": [
    "S26.assumptions.section-I"
  ],
  "references": [
    "FNC",
    "STABILITY"
  ],
  "verification": [
    "S26.fixtures.section-M"
  ]
}

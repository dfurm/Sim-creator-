{
  "id": "S14",
  "version": "0.1.0",
  "metadata": {
    "title": "Convection from a plate and the Nusselt number",
    "subject": "Heat transfer",
    "objectives": [
      "Choose U to meet a target heat duty under a velocity cap. Compare whole-face and trailing-edge estimates. Transfer to internal flow and identify boundary condition data required before selecting a correlation."
    ],
    "fidelity": [
      "F2"
    ]
  },
  "variant": "starter",
  "model": "model.S14.starter",
  "inputs": [

      "id": "U",
      "label": "Free-stream velocity U",
      "unit": "m/s",
      "min": 0.2,
      "max": 15.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "cm/s",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "L",
      "label": "Heated plate length L",
      "unit": "m",
      "min": 0.05,
      "max": 1.0,
      "default": 0.3,
      "step": 0.01,
      "alternative": "mm",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "Pr",
      "label": "Teaching-fluid Pr",
      "unit": "1",
      "min": 0.6,
      "max": 10.0,
      "default": 0.7,
      "step": 0.1,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",

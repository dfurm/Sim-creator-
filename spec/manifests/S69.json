{
  "id": "S69",
  "version": "0.1.0",
  "metadata": {
    "title": "Sensor lag, actuator dynamics and fault diagnosis",
    "subject": "Control",
    "objectives": [
      "Distinguish a stuck instrument from an actuator fault using a second measurement."
    ],
    "fidelity": [
      "F4"
    ]
  },
  "variant": "starter",
  "model": "model.S69.starter",
  "inputs": [
    {
      "id": "ts",
      "label": "Sensor lag τₛ",
      "unit": "s",
      "min": 0.1,
      "max": 10.0,
      "default": 1.0,
      "step": 0.1,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "ta",
      "label": "Actuator lag τₐ",
      "unit": "s",
      "min": 0.1,
      "max": 10.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "b",
      "label": "Sensor bias b",
      "unit": "1",
      "min": -0.3,
      "max": 0.3,
      "default": 0.0,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [

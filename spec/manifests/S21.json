{
  "id": "S21",
  "version": "0.1.0",
  "metadata": {
    "title": "Arrhenius temperature sensitivity",
    "subject": "Reaction engineering",
    "objectives": [
      "Determine T for a target k, then check calibration interval and sensitivity. Extension: fit independent rate measurements and examine lever arm in 1/T."
    ],
    "fidelity": [
      "F1"
    ]
  },
  "variant": "starter",
  "model": "model.S21.starter",
  "inputs": [
    {
      "id": "kr",
      "label": "First-order reference kᵣ",
      "unit": "1/s",
      "min": 0.001,
      "max": 0.1,
      "default": 0.01,
      "step": 0.001,
      "alternative": "1/min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "Ea",
      "label": "Activation energy Eₐ",
      "unit": "J/mol",
      "min": 10000.0,
      "max": 100000.0,
      "default": 50000.0,
      "step": 1000.0,
      "alternative": "kJ/mol",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "Tr",
      "label": "Reference temperature Tᵣ",
      "unit": "K",
      "min": 280.0,
      "max": 360.0,
      "default": 300.0,
      "step": 1.0,
      "alternative": "°C",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "T",
      "label": "Operating temperature T",
      "unit": "K",
      "min": 280.0,
      "max": 360.0,
      "default": 310.0,
      "step": 1.0,
      "alternative": "°C",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "k",
      "unit": "1/s"
    },
    {
      "id": "rate_ratio",
      "unit": "1"
    },
    {
      "id": "inverse_temperature",
      "unit": "1/K"
    },
    {
      "id": "log_ratio",
      "unit": "1"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S21",
    "anchors": [
      "activation_slope",
      "temperature_reference",
      "rate_marker"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S21.investigate",
    "activity.S21.challenge"
  ],
  "applicabilityRules": [
    "S21.assumptions.section-I"
  ],
  "references": [
    "IUPAC"
  ],
  "verification": [
    "S21.fixtures.section-M"
  ]
}

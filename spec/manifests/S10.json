{
  "id": "S10",
  "version": "0.1.0",
  "metadata": {
    "title": "Pipe selection and pump duty",
    "subject": "Equipment design",
    "objectives": [
      "Filter v≤vmax; rank by energy and bore, preserve nondominated candidates. For pump selection use S09 teaching curve at a speed that meets Hreq, subject to allowed speed and forward range; missing vendor evidence means preliminary duty only."
    ],
    "fidelity": [
      "F2",
      "F3"
    ]
  },
  "variant": "starter",
  "model": "model.S10.starter",
  "inputs": [
    {
      "id": "Q",
      "label": "Required flow Q",
      "unit": "m³/s",
      "min": 0.0001,
      "max": 0.005,
      "default": 0.001,
      "step": 0.0001,
      "alternative": "L/min",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "L",
      "label": "Pipe length L",
      "unit": "m",
      "min": 1.0,
      "max": 150.0,
      "default": 20.0,
      "step": 1.0,
      "alternative": "mm",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "dz",
      "label": "Static lift Δz",
      "unit": "m",
      "min": 0.0,
      "max": 10.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "mm",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "f",
      "label": "Assumed Darcy factor f",
      "unit": "1",
      "min": 0.01,
      "max": 0.06,
      "default": 0.02,
      "step": 0.001,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "K",
      "label": "Minor loss sum ΣK",
      "unit": "1",
      "min": 0.0,
      "max": 20.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "eta",
      "label": "Pump efficiency η",
      "unit": "1",
      "min": 0.3,
      "max": 0.9,
      "default": 0.6,
      "step": 0.01,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "vmax",
      "label": "Velocity ceiling vₘ",
      "unit": "m/s",
      "min": 0.5,
      "max": 4.0,
      "default": 2.0,
      "step": 0.1,
      "alternative": "cm/s",
      "scale": "linear",
      "widget": "slider + numeric",

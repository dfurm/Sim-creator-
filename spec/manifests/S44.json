{
  "id": "S44",
  "version": "0.1.0",
  "metadata": {
    "title": "Surface tension and capillary rise",
    "subject": "Fluids",
    "objectives": [
      "Infer σ only if θ and radius are independently known."
    ],
    "fidelity": [
      "F1"
    ]
  },
  "variant": "starter",
  "model": "model.S44.starter",
  "inputs": [
    {
      "id": "r",
      "label": "Capillary radius r",
      "unit": "m",
      "min": 0.0001,
      "max": 0.002,
      "default": 0.001,
      "step": 0.0001,
      "alternative": "mm",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "theta",
      "label": "Contact angle θ",
      "unit": "rad",
      "min": 0.0,
      "max": 3.14,
      "default": 0.0,
      "step": 0.01,
      "alternative": "degrees",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
    {
      "id": "sig",
      "label": "Surface tension σ",
      "unit": "N/m",
      "min": 0.02,
      "max": 0.08,
      "default": 0.07,
      "step": 0.001,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    }
  ],
  "outputs": [
    {
      "id": "rise",
      "unit": "m"
    },
    {
      "id": "capillary_pressure",
      "unit": "Pa"
    }
  ],
  "unitSystem": "SI",
  "rendering": {
    "scene": "scene.S44",
    "anchors": [
      "equipment_view",
      "operating_point"
    ]
  },
  "initialState": {},
  "scenario": "builtin.defaults",
  "activities": [
    "activity.S44.investigate",
    "activity.S44.challenge"
  ],
  "applicabilityRules": [
    "S44.assumptions.section-I"
  ],
  "references": [
    "PERRY"
  ],
  "verification": [
    "S44.fixtures.section-M"
  ]
}

      "unit": "W/(m·K)",
      "min": 0.05,
      "max": 10.0,
      "default": 0.5,
      "step": 0.05,
      "alternative": "same",
      "scale": "linear",
      "widget": "slider + numeric",
      "role": "editable in active mode"
    },
